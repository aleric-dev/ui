{
  "name": "@aleric.dev/ui",
  "version": "0.3.0",
  "description": "Atomic UI Component System for Aleric Dev ecosystem",
  "author": "Aleric Dev <contacto@aleric.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleric-dev/ui.git"
  },
  "homepage": "https://github.com/aleric-dev/ui#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/ui.css",
    "./ui.css": "./dist/ui.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib",
    "preview": "vite preview",
    "release:auto": "node scripts/auto-release.cjs",
    "release:dry": "node scripts/auto-release.cjs --dry-run",
    "release:patch": "node scripts/release.cjs patch",
    "release:minor": "node scripts/release.cjs minor",
    "release:major": "node scripts/release.cjs major"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.7",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "bin": {
    "aleric-ui": "bin/cli.cjs",
    "ui": "bin/cli.cjs"
  }
}
